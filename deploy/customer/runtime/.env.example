# Run: sudo bash install.sh init
# The installer generates independent random values for the blank security fields.
# Keep this customer .env outside source control and back it up separately, encrypted.
COMPOSE_PROJECT_NAME=jiangqing-customer
DATA_DIR=/opt/jiangqing/data
BACKUP_DIR=/opt/jiangqing/backups
BACKUP_KEEP=7
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5185
TZ=Asia/Shanghai

API_IMAGE=jiangqing-api:0.2.0
WEB_IMAGE=jiangqing-web:0.2.0
PROVISIONER_IMAGE=jiangqing-provisioner:0.2.0
SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest

YUXI_INSTANCE_ID=
JWT_SECRET_KEY=
API_KEY_DERIVATION_SECRET=
SANDBOX_PROVISIONER_TOKEN=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Model credentials are customer runtime configuration, never image build inputs.
# Use single quotes for literal values containing a dollar sign.
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-compatible-provider.example/v1
# DASHSCOPE_API_KEY=
# MINERU_API_URI=http://customer-parser:30001
# PADDLEX_URI=http://customer-ocr:8080

# Customer reverse proxy terminates TLS and forwards to 127.0.0.1:5185.
# Remote microphone capture requires HTTPS. Set the actual browser origin here.
YUXI_CORS_ORIGINS=
